/*
	* Shadow/Int/Int.xal - Interrupt manifest
*/

XAL_META(Class, xSCAL)

/*
	* Builds and loads the IDT. Every vector initially points at a stub
	* that reports through IdtDefaultFault (exceptions) or is silently
	* EOI'd (unregistered IRQs). Nothing is left unhandled by default.
*/

XAL_METHOD(VOID,     IdtInit,            (VOID))
XAL_METHOD(SHSTATUS, IdtRegisterHandler, (IN UINT8 Vector, IN INTERRUPT_HANDLER Handler))
 
/*
	* Called from Isr.S's common trampoline. Not meant to be called from anywhere else.
*/

XAL_METHOD(VOID,     IdtDispatch,        (IN _PINTERRUPT_FRAME Frame))
 
XAL_METHOD(VOID,     GdtInit,            (VOID))
XAL_METHOD(UINT64,   CreateDescriptor,   (IN UINT32 Base, IN UINT32 Limit, IN UINT16 Flag))