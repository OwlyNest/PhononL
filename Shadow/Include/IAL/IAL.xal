/*
	* Shadow/IAL/IAL.xal - IAL manifest
*/

XAL_META(Class,   xMCAL)

XAL_METHOD(INT, Init,
    (_PIAL_BACKEND Self),          /* StructArgs  */
    (VOID),                        /* PublicArgs  */
    (ActiveBackend),               /* CallArgs    */
    -1)

XAL_METHOD(UINT8, GetVectorBase,
    (_PIAL_BACKEND Self),
    (VOID),
    (ActiveBackend),
    -1)

XAL_METHOD_VOID(EnableIrq,
    (_PIAL_BACKEND Self, IN UINT8 Irq),
    (IN UINT8 Irq),
    (ActiveBackend, Irq))

XAL_METHOD_VOID(DisableIrq,
    (_PIAL_BACKEND Self, IN UINT8 Irq),
    (IN UINT8 Irq),
    (ActiveBackend, Irq))

XAL_METHOD_VOID(SendEoi,
    (_PIAL_BACKEND Self, IN UINT8 Vector),
    (IN UINT8 Vector),
    (ActiveBackend, Vector))